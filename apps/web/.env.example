# ==============================================================================
# MD Shakib Islamic Books — Environment Variables Template
# Phase 1 Migration: Apps/Web Environment Contract
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Database & Authentication - Phase 2)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Resend (Transactional Email Delivery - Phase 5)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MD Shakib Book Store <orders@mdshakib.com>"
ADMIN_EMAIL="admin@mdshakib.com"

# Razorpay (Payment Processing - Phase 5)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cloudinary (Product & Catalog Image Storage - Phase 5)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Delhivery (Logistics & Shipment Tracking - Phase 5)
DELHIVERY_API_URL="https://track.delhivery.com"
DELHIVERY_TOKEN="your_delhivery_api_token"
DELHIVERY_WEBHOOK_SECRET="your_delhivery_webhook_secret"
DELHIVERY_CLIENT_NAME="your_client_name"
DELHIVERY_PICKUP_LOCATION="Primary Warehouse"

