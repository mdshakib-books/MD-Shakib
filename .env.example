# ==============================================================================
# Environment Configuration Template: MD Shakib Islamic Books
# Note: Keep secrets private and never commit .env.local to Git.
# ==============================================================================

# Application URL (Canonical site base URL for auth redirects, emails, and CORS)
# In production, set to your canonical domain (e.g., "https://mdshakibbooks.com").
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase (Server-only - Required for webhooks & admin tasks)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Resend (Transactional Email Delivery)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MD Shakib Books <orders@mdshakib.com>"
ADMIN_EMAIL="admin@mdshakib.com"

# Razorpay (Payment Processing)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cloudinary (Media Storage & Upload Authorization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Delhivery (Logistics & Shipment Tracking)
DELHIVERY_API_URL="https://track.delhivery.com"
DELHIVERY_TOKEN="your_delhivery_api_token"
DELHIVERY_WEBHOOK_SECRET="your_delhivery_webhook_secret"
DELHIVERY_PICKUP_LOCATION="Primary Warehouse"
