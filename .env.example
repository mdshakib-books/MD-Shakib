# ==============================================================================
# Environment Configuration Template: MD Shakib Islamic Books
# Copy to apps/web/.env.local for local development.
# NEVER commit .env, .env.local, or any real secrets/credentials to Git.
# ==============================================================================

# Environment Identification
# Allowed values: local | development | test | preview | staging | production
APP_ENV="local"
NEXT_PUBLIC_APP_ENV="local"

# Application URL (Canonical site base URL for auth redirects, emails, and SEO)
# In production, set to your canonical HTTPS domain (e.g., "https://mdshakibbooks.com").
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Supabase (Database & Authentication)
# Local dev MUST use local Supabase (http://127.0.0.1:54321) or a dedicated
# development Supabase project — NEVER the production Supabase project.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-or-dev-supabase-anon-key"
# SERVER-ONLY: Never prefix with NEXT_PUBLIC_ or expose to browser code
SUPABASE_SERVICE_ROLE_KEY="your_local_or_dev_supabase_service_role_key"

# Optional Supabase Project Isolation Guardrails (Recommended)
# Set SUPABASE_PRODUCTION_PROJECT_REF in local/preview/staging so validators
# explicitly reject accidental connections to the production project ref.
SUPABASE_PRODUCTION_PROJECT_REF=""
# To use a dedicated remote development Supabase project locally, set both:
SUPABASE_ALLOW_REMOTE_DEV="false"
SUPABASE_DEV_PROJECT_REF=""

# ==============================================================================
# Service Kill Switches & Mock Isolation
# Safe defaults: all external integrations default to "false" in development.
# ALLOW_MOCK_SERVICES may ONLY be "true" in local/development/test (never preview/staging/production).
# ==============================================================================
ENABLE_RAZORPAY="false"
ENABLE_EMAILS="false"
ENABLE_CLOUDINARY="false"
ENABLE_DELHIVERY="false"
ALLOW_MOCK_SERVICES="false"

# ==============================================================================
# Razorpay (Payment Processing)
# Use rzp_test_* in local/preview/staging; rzp_live_* is ONLY allowed in production.
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ==============================================================================
# Resend (Transactional Email Delivery)
# ==============================================================================
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MD Shakib Books <orders@mdshakib.com>"
EMAIL_SUPPORT="support@mdshakib.com"
ADMIN_ALERT_EMAIL="orders@mdshakib.com"

# ==============================================================================
# Cloudinary (Product & Catalog Media Storage)
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_dev_cloud_name"
CLOUDINARY_API_KEY="your_dev_api_key"
CLOUDINARY_API_SECRET="your_dev_api_secret"

# ==============================================================================
# Delhivery (Logistics & Shipment Tracking)
# Use https://staging-express.delhivery.com in non-production environments.
# Production uses https://track.delhivery.com.
# ==============================================================================
DELHIVERY_API_URL="https://staging-express.delhivery.com"
DELHIVERY_TOKEN="your_delhivery_sandbox_token"
DELHIVERY_WEBHOOK_SECRET="your_delhivery_webhook_secret"
DELHIVERY_PICKUP_LOCATION="Primary Warehouse"

# ==============================================================================
# Security & Statutory Business Disclosures (Required in Production)
# ==============================================================================
DELIVERY_OTP_HMAC_SECRET="replace-with-32-byte-random-hex-secret"
# Secret token for scheduled reservation cleanup endpoint (/api/cron/release-reservations)
CRON_SECRET="replace-with-32-byte-random-hex-cron-secret"
BUSINESS_LEGAL_NAME="MD Shakib Islamic Books"
BUSINESS_REGISTERED_ADDRESS=""
BUSINESS_PHONE=""
BUSINESS_GSTIN=""
BUSINESS_STATE_CODE="07"
BUSINESS_CIN=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_DESIGNATION="Head of Customer Redressal & Compliance"
GRIEVANCE_OFFICER_EMAIL="grievance@mdshakib.com"
GRIEVANCE_OFFICER_PHONE=""
GRIEVANCE_OFFICER_ADDRESS=""
